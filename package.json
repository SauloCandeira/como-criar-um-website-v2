{
  "name": "como-cria-um-website-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "ia:pull": "node scripts/ia-pull-prompts.js",
    "ia:push": "node scripts/ia-push-prompts.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "build": "tsc && vite build",
    "test:jest": "npm --prefix functions run build && jest --coverage",
    "test:e2e": "playwright test",
    "test": "npm run test:jest && npm run test:e2e",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky install",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.6.0",
    "@prisma/client": "^7.4.0",
    "axios": "^1.8.1",
    "chart.js": "^4.4.8",
    "firebase": "^10.13.2",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.4",
    "flag-icon-css": "^4.1.7",
    "i18next": "^23.14.0",
    "i18next-http-backend": "^2.6.1",
    "prisma": "^7.4.0",
    "react": "^19.2.4",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.2.4",
    "react-i18next": "^15.0.1",
    "react-router-dom": "^6.26.2",
    "react-slick": "^0.30.3",
    "react-tabs": "^6.0.2",
    "slick-carousel": "^1.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@storybook/addon-essentials": "8.6.14",
